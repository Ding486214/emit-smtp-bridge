# ── 环境变量（复制为 .env 后填写；切勿提交 .env）──────────────────────────
# Emit API key：在 vsllm.cc 控制台 Emit 页面创建，只显示一次
EMIT_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 监听 ────────────────────────────────────────────────────────────────
# 本机测试用 127.0.0.1，公网服务器用 0.0.0.0
EMIT_SMTP_HOST=127.0.0.1
# 587 = 明文监听 + STARTTLS（推荐）；465 = 隐式 TLS（需 EMIT_SMTP_SECURE=1）
EMIT_SMTP_PORT=587
EMIT_SMTP_SECURE=0

# ── TLS 证书（可选；公网建议配置）──────────────────────────────────────
#EMIT_TLS_CERT=/etc/letsencrypt/live/mail.example.com/fullchain.pem
#EMIT_TLS_KEY=/etc/letsencrypt/live/mail.example.com/privkey.pem

# ── SMTP 认证（公网部署务必开启）────────────────────────────────────────
#EMIT_SMTP_USER=yourname
#EMIT_SMTP_PASS=change-me-to-a-strong-password

# ── 其它 ────────────────────────────────────────────────────────────────
EMIT_ALLOW_ANY_FROM=0
EMIT_MAX_CLIENTS=50
# 每个 IP 每小时最多发信数，0 = 不限
EMIT_RATE_PER_HOUR=120
EMIT_MAX_SIZE_MB=20
#EMIT_LOG_FILE=/var/log/emit-smtp.log
# 自定义 Emit 端点（自建/测试用）
#EMIT_URL=https://vsllm.cc/emit/v1/emails

# ── Web 管理台（可选；设置了 WEB_PORT 才启用）────────────────────────────
#WEB_PORT=3000
#WEB_USER=admin
# 下面两个是 scrypt 哈希与盐，由部署脚本自动生成，勿手填
#WEB_PASS_HASH=...
#WEB_SALT=...
#WEB_SESSION_SECRET=<部署脚本自动生成>
# 复用 SMTP 的 TLS 证书；也可单独指定
#WEB_CERT=/etc/emit-smtp/cert.pem
#WEB_KEY=/etc/emit-smtp/key.pem
# 发送历史文件（默认 ./data/history.jsonl）
#EMIT_HISTORY_FILE=/opt/emit-smtp/data/history.jsonl
# root 守护进程 socket（供“完整管理”调用）
#CTL_SOCK=/run/emit-smtp/ctl.sock
