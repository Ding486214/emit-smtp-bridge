# 默认按文本处理，提交时统一为 LF
* text=auto eol=lf

# 明确不参与行尾转换的二进制
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary

# 脚本与服务文件在 Linux 上必须保持 LF（CRLF 会导致 bash 报 "\r: command not found"）
*.sh text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 端点脚本保持 CRLF
*.cmd text eol=crlf
*.ps1 text eol=crlf
